// A FujiNet stand-in for timing BomberNet's SIO on the Atari in Altirra:
// the network device N1: (71h) answers status, read, write, open, close
// and the high-speed query as FujiNet's firmware does on its serial port
// (lib/bus/sio/sio.cpp), with its delays, but without a network: after
// each write, IN_LEN bytes of the relay's binary input lines wait to be
// read. Everything runs in emulated time, so a benchmark on the Atari
// measures what an XL with a FujiNet would spend.
//
// Delays (FujiNet firmware): 250 us (DELAY_T5) before 'A' is done and
// before 'C' or 'E'; at high speed 1 ms (DELAY_HSIO_DATA) from 'C' to a
// data frame; 850 us (DELAY_T4) after receiving a data frame. FujiNet's
// own latency after the command frame: 100 us (an ESP32 polling the line).
// 1.79 MHz: 1 us = 1.79 cycles.

option "name": "BomberNet fake FujiNet (timing)";

int dev;
int cmd;
int aux;
int cpb;          // cycles per bit of the Atari's last byte: answer at that rate
int hs;           // 1 once switched to the high speed
int pending;      // bytes waiting to be read
int chk;
int i;
int b;
int n;
int in_len;

Segment frame: { size: 8 };

Thread main_thread;

function void sendb()
{
    $sio.send_raw_byte(b, cpb);
    chk = chk + b;
    if (chk > 255) { chk = chk - 255; }
}

function void complete()
{
    Thread.sleep(447);              // DELAY_T5
    b = $43; $sio.send_raw_byte(b, cpb);
    if (hs) { Thread.sleep(1790); } // DELAY_HSIO_DATA
    chk = 0;
}

function void ack()
{
    b = $41; $sio.send_raw_byte(b, cpb);
    Thread.sleep(447);              // DELAY_T5
}

function void endframe()            // the data frame's checksum
{
    b = chk; $sio.send_raw_byte(b, cpb);
}

function void get_data()            // n bytes and a checksum from the Atari, then DELAY_T4 and 'A'
{
    i = 0;
    loop {
        if (i > n) {
            Thread.sleep(1521);     // DELAY_T4
            b = $41; $sio.send_raw_byte(b, cpb);
            return;
        }
        b = $sio.recv_raw_byte();
        i = i + 1;
    }
}

function void send_read()           // aux bytes of data (their content does not matter here)
{
    n = 0;
    loop {
        if (n >= aux) {
            endframe();
            pending = pending - aux;
            if (pending < 0) { pending = 0; }
            return;
        }
        b = 0; sendb();
        n = n + 1;
    }
}

function void read_frame()          // the 5 bytes of a command frame
{
    i = 0;
    loop {
        if (i >= 5) { return; }
        b = $sio.recv_raw_byte();
        if (i == 0) { cpb = $aux; }
        frame.write_byte(i, b);
        i = i + 1;
    }
}

function void command()
{
    dev = frame.read_byte(0);
    cmd = frame.read_byte(1);
    aux = frame.read_byte(2) + 256 * frame.read_byte(3);
    if (dev != $71) { return; }
    if (cmd == $53) {                   // status
        ack(); complete();
        b = pending & 255; sendb(); b = pending >> 8; sendb();
        b = 1; sendb(); b = 1; sendb(); endframe();
    } else if (cmd == $52) {            // read aux bytes
        ack(); complete(); send_read();
    } else if (cmd == $57) {            // write aux bytes
        ack(); n = aux; get_data();
        Thread.sleep(447); b = $43; $sio.send_raw_byte(b, cpb);
        pending = pending + in_len;
    } else if (cmd == $4F) {            // open: 256 bytes
        ack(); n = 256; get_data();
        Thread.sleep(447); b = $43; $sio.send_raw_byte(b, cpb);
        pending = 0;
    } else if (cmd == $43) {            // close
        ack(); Thread.sleep(447); b = $43; $sio.send_raw_byte(b, cpb);
    } else if (cmd == $3F) {            // high-speed index 8, then that speed
        ack(); complete(); b = 8; sendb(); endframe();
        Thread.sleep(3580);
        cpb = 30; hs = 1;
    } else if (cmd == $49) {            // benchmark: aux = bytes waiting after each write
        ack(); Thread.sleep(447); b = $43; $sio.send_raw_byte(b, cpb);
        in_len = aux;
    }
}

function void main_loop()
{
    loop {
        $sio.wait_command();
        read_frame();
        $sio.wait_command_off();
        Thread.sleep(179);              // FujiNet sees COMMAND high
        command();
    }
}

event "cold_reset": function
{
    cpb = 94; hs = 0; pending = 0; in_len = 9;
    $sio.enable_raw(true);
    main_thread.run(main_loop);
};
