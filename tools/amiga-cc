#!/bin/sh
# The AmigaOS gcc (bebbo's, the amigadev/crosstools:m68k-amigaos Docker
# image) with the repository mounted: tools/amiga-cc [gcc arguments], paths
# relative to the repository root (docs/port-amiga.md).
cd "$(dirname "$0")/.." || exit 1
exec docker run --rm -u "$(id -u):$(id -g)" -v "$PWD:/work" -w /work amigadev/crosstools:m68k-amigaos m68k-amigaos-gcc "$@"
