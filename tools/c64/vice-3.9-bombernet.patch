+/* local patch (BomberNet tests): with WIC64_FW_TIMING set in the
+   environment, TCP read and write answer after the pauses the WiC64
+   firmware takes around its transfers (userport.cpp, service.cpp: 3 ms
+   after a transfer, 1 ms before sending, 5 ms between the parts of a split
+   one) instead of a TV frame, and a read answers once (VICE re-arms its
+   alarm and sends unasked replies every 30 frames) */
+static int fw_timing(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        v = getenv("WIC64_FW_TIMING") != NULL;
+    }
+    return v;
+}
+#define FW_MS(ms) ((CLOCK)((ms) * machine_get_cycles_per_second() / 1000))
+
