--- /dev/null
+++ b/src/c64/uci_net.c	2026-10-22 12:03:31.416744974 +0200
@@ -0,0 +1,296 @@
+/*
+ * uci_net.c - local patch (BomberNet tests): the Ultimate Command Interface
+ * at $DF1C-$DF1F with its network target ($03), over real sockets.
+ *
+ * Included from c64.c; on when UCI_EMU is set in the environment. Modelled
+ * on the Ultimate's documentation (1541u-documentation, uci/) and its
+ * firmware (github.com/GideonZ/1541ultimate, software/io/network/
+ * network_target.cc): registers, the state machine (idle, command busy,
+ * data last, data more), the queues; IDENTIFY, GET_INTERFACE_COUNT,
+ * OPEN_TCP, CLOSE_SOCKET, READ_SOCKET, WRITE_SOCKET. A read with nothing
+ * waiting holds the interface busy up to 40 ms, as the firmware's
+ * SO_RCVTIMEO does, and answers "02,NO DATA" with a count of $FFFF; data
+ * that comes meanwhile is returned at once. Other commands take
+ * UCI_CMD_MS (1 ms, an assumption: the Ultimate's processor is fast).
+ * Not modelled: blocks of more than one queue (BomberNet reads at most 512
+ * bytes), the other targets, DMA, interrupts.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include "alarm.h"
+#include "cartio.h"
+#include "maincpu.h"
+#include "machine.h"
+
+#define UCI_QUEUE    896
+#define UCI_STATQ    256
+#define UCI_CMD_MS   1
+#define UCI_SOCKETS  8
+
+enum { UCI_IDLE = 0, UCI_BUSY = 1, UCI_LAST = 2, UCI_MORE = 3 };
+
+static uint8_t uci_cmd[UCI_QUEUE + 1], uci_data[UCI_QUEUE], uci_stat[UCI_STATQ];
+static int uci_cmd_len, uci_data_len, uci_data_pos, uci_stat_len, uci_stat_pos;
+static int uci_state, uci_error;
+static int uci_fd[UCI_SOCKETS + 1];          /* 1..UCI_SOCKETS; 0 unused */
+static alarm_t *uci_alarm;
+static int uci_wait_reads;                   /* a read with nothing waiting: polls left (2 ms each) */
+
+static CLOCK uci_ms(int ms)
+{
+    return (CLOCK)ms * (CLOCK)machine_get_cycles_per_second() / 1000;
+}
+
+static void uci_reply(const uint8_t *data, int n, const char *status)
+{
+    if (n > UCI_QUEUE) {
+        n = UCI_QUEUE;
+    }
+    memcpy(uci_data, data, (size_t)n);
+    uci_data_len = n;
+    uci_data_pos = 0;
+    uci_stat_len = (int)strlen(status);
+    memcpy(uci_stat, status, (size_t)uci_stat_len);
+    uci_stat_pos = 0;
+    uci_state = UCI_LAST;
+}
+
+/* a read: data now, or (none) poll again in 2 ms, up to 40 ms */
+static int uci_try_read(void)
+{
+    int s = uci_cmd[2], want = uci_cmd[3] | (uci_cmd[4] << 8), n;
+    uint8_t buf[2 + UCI_QUEUE];
+
+    if (s < 1 || s > UCI_SOCKETS || uci_fd[s] < 0) {
+        uci_reply((const uint8_t *)"\xff\xff", 2, "02,NO DATA: 9");
+        return 1;
+    }
+    if (want > UCI_QUEUE - 2) {
+        want = UCI_QUEUE - 2;
+    }
+    n = (int)recv(uci_fd[s], buf + 2, (size_t)want, MSG_DONTWAIT);
+    if (n > 0) {
+        buf[0] = (uint8_t)n;
+        buf[1] = (uint8_t)(n >> 8);
+        uci_reply(buf, n + 2, "00,OK");
+        return 1;
+    }
+    if (n == 0) {                            /* the peer closed */
+        close(uci_fd[s]);
+        uci_fd[s] = -1;
+        uci_reply((const uint8_t *)"\0\0", 2, "01,CONNECTION CLOSED BY HOST");
+        return 1;
+    }
+    if (errno != EAGAIN && errno != EWOULDBLOCK) {
+        uci_reply((const uint8_t *)"\xff\xff", 2, "02,NO DATA: 104");
+        return 1;
+    }
+    if (--uci_wait_reads > 0) {
+        return 0;
+    }
+    uci_reply((const uint8_t *)"\xff\xff", 2, "02,NO DATA: 11");
+    return 1;
+}
+
+static void uci_execute(void)
+{
+    uint8_t r[4];
+
+    if (uci_cmd_len < 2 || uci_cmd[0] != 0x03) {
+        uci_reply(NULL, 0, "81,INVALID PARAMS");
+        return;
+    }
+    switch (uci_cmd[1]) {
+        case 0x01:                           /* IDENTIFY */
+            uci_reply((const uint8_t *)"ULTIMATE-II NETWORK INTERFACE V1.0", 34, "00,OK");
+            break;
+        case 0x02:                           /* GET_INTERFACE_COUNT */
+            r[0] = 1;
+            uci_reply(r, 1, "00,OK");
+            break;
+        case 0x07: {                         /* OPEN_TCP: port (low, high), host */
+            struct addrinfo hints, *ai = NULL;
+            char port[8];
+            int fd, s;
+
+            uci_cmd[uci_cmd_len] = 0;
+            snprintf(port, sizeof(port), "%d", uci_cmd[2] | (uci_cmd[3] << 8));
+            memset(&hints, 0, sizeof(hints));
+            hints.ai_family = AF_INET;
+            hints.ai_socktype = SOCK_STREAM;
+            if (uci_cmd_len < 5 || getaddrinfo((const char *)&uci_cmd[4], port, &hints, &ai) != 0) {
+                uci_reply(NULL, 0, "84,UNRESOLVED HOST");
+                break;
+            }
+            for (s = 1; s <= UCI_SOCKETS && uci_fd[s] >= 0; s++) {
+            }
+            fd = socket(AF_INET, SOCK_STREAM, 0);
+            if (s > UCI_SOCKETS || fd < 0 || connect(fd, ai->ai_addr, ai->ai_addrlen) < 0) {
+                if (fd >= 0) {
+                    close(fd);
+                }
+                uci_reply(NULL, 0, "11,ERROR ON CONNECT: 113");
+            } else {
+                uci_fd[s] = fd;
+                r[0] = (uint8_t)s;
+                uci_reply(r, 1, "00,OK");
+            }
+            freeaddrinfo(ai);
+            break;
+        }
+        case 0x09:                           /* CLOSE_SOCKET */
+            if (uci_cmd_len == 3 && uci_cmd[2] >= 1 && uci_cmd[2] <= UCI_SOCKETS && uci_fd[uci_cmd[2]] >= 0) {
+                close(uci_fd[uci_cmd[2]]);
+                uci_fd[uci_cmd[2]] = -1;
+            }
+            uci_reply(NULL, 0, "00,OK");
+            break;
+        case 0x10:                           /* READ_SOCKET: socket, length (low, high) */
+            if (uci_cmd_len != 5) {
+                uci_reply(NULL, 0, "81,INVALID PARAMS");
+                break;
+            }
+            uci_wait_reads = 20;
+            if (!uci_try_read()) {
+                alarm_set(uci_alarm, maincpu_clk + uci_ms(2));
+            }
+            break;
+        case 0x11: {                         /* WRITE_SOCKET: socket, data */
+            int s = uci_cmd_len > 2 ? uci_cmd[2] : 0, n = uci_cmd_len - 3, sent = 0;
+
+            if (s >= 1 && s <= UCI_SOCKETS && uci_fd[s] >= 0 && n > 0) {
+                sent = (int)send(uci_fd[s], uci_cmd + 3, (size_t)n, 0);
+            }
+            r[0] = (uint8_t)(sent < 0 ? 0 : sent);
+            r[1] = (uint8_t)((sent < 0 ? 0 : sent) >> 8);
+            uci_reply(r, 2, sent == n ? "00,OK" : "03,ERROR ON WRITE");
+            break;
+        }
+        default:
+            uci_reply(NULL, 0, "81,INVALID PARAMS");
+            break;
+    }
+}
+
+static void uci_alarm_handler(CLOCK offset, void *data)
+{
+    alarm_unset(uci_alarm);
+    if (uci_state != UCI_BUSY) {
+        return;
+    }
+    if (uci_wait_reads > 0) {                /* a read still waiting for data */
+        if (!uci_try_read()) {
+            alarm_set(uci_alarm, maincpu_clk + uci_ms(2));
+        }
+        return;
+    }
+    uci_execute();
+}
+
+static void uci_store(uint16_t addr, uint8_t value)
+{
+    switch (addr & 3) {
+        case 0:                              /* $DF1C: control */
+            if (value & 0x08) {
+                uci_error = 0;
+            }
+            if (value & 0x04) {              /* abort */
+                if (uci_alarm) {
+                    alarm_unset(uci_alarm);
+                }
+                uci_state = UCI_IDLE;
+                uci_cmd_len = uci_data_len = uci_stat_len = 0;
+                uci_wait_reads = 0;
+            }
+            if (value & 0x02) {              /* data accepted */
+                if (uci_state == UCI_LAST || uci_state == UCI_MORE) {
+                    uci_state = UCI_IDLE;
+                    uci_cmd_len = uci_data_len = uci_data_pos = uci_stat_len = uci_stat_pos = 0;
+                }
+            }
+            if (value & 0x01) {              /* push the command */
+                if (uci_state != UCI_IDLE) {
+                    uci_error = 1;
+                } else {
+                    uci_state = UCI_BUSY;
+                    uci_wait_reads = 0;
+                    if (!uci_alarm) {
+                        uci_alarm = alarm_new(maincpu_alarm_context, "UCIAlarm", uci_alarm_handler, NULL);
+                    }
+                    alarm_set(uci_alarm, maincpu_clk + uci_ms(UCI_CMD_MS));
+                }
+            }
+            break;
+        case 1:                              /* $DF1D: command data */
+            if (uci_state == UCI_IDLE && uci_cmd_len < UCI_QUEUE) {
+                uci_cmd[uci_cmd_len++] = value;
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+static uint8_t uci_peek(uint16_t addr)
+{
+    switch (addr & 3) {
+        case 0:                              /* status */
+            return (uint8_t)((uci_data_pos < uci_data_len ? 0x80 : 0) | (uci_stat_pos < uci_stat_len ? 0x40 : 0)
+                             | (uci_state << 4) | (uci_error ? 0x08 : 0) | (uci_state == UCI_BUSY ? 0x01 : 0));
+        case 1:
+            return 0xc9;                     /* identification */
+        case 2:
+            return uci_data_pos < uci_data_len ? uci_data[uci_data_pos] : 0;
+        default:
+            return uci_stat_pos < uci_stat_len ? uci_stat[uci_stat_pos] : 0;
+    }
+}
+
+static uint8_t uci_read(uint16_t addr)
+{
+    uint8_t v = uci_peek(addr);
+
+    if ((addr & 3) == 2 && uci_data_pos < uci_data_len) {
+        uci_data_pos++;
+    } else if ((addr & 3) == 3 && uci_stat_pos < uci_stat_len) {
+        uci_stat_pos++;
+    }
+    return v;
+}
+
+static io_source_t uci_device = {
+    "Ultimate Command Interface (BomberNet test)",
+    IO_DETACH_NEVER,
+    IO_DETACH_NO_RESOURCE,
+    0xdf1c, 0xdf1f, 0x03,
+    1,
+    uci_store,
+    NULL,
+    uci_read,
+    uci_peek,
+    NULL,
+    0,
+    IO_PRIO_NORMAL,
+    0,
+    IO_MIRROR_NONE
+};
+
+static void uci_net_init(void)
+{
+    int i;
+
+    if (!getenv("UCI_EMU")) {
+        return;
+    }
+    for (i = 0; i <= UCI_SOCKETS; i++) {
+        uci_fd[i] = -1;
+    }
+    io_source_register(&uci_device);
+}
