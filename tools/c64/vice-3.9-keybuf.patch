+/* local patch (BomberNet tests): keybuf "#row col value" holds a key of the
+   keyboard matrix down (value 1) or lets it go (0), for programs that scan
+   the matrix themselves; keybuf "#J port bits" sets joystick port 1 or 2
+   (bits: up 1, down 2, left 4, right 8, fire 16); anything else goes into
+   the keyboard buffer */
 void mon_keyboard_feed(const char *string)
 {
+    int row, col, value;
+    const char *p = string;
+
+    while (*p == '"' || *p == ' ') {
+        p++;
+    }
+    if (*p == '#' && p[1] == 'J' && sscanf(p + 2, "%d %d", &row, &value) == 2) {
+        joystick_set_value_absolute((unsigned int)row - 1, (uint16_t)value);   /* "#J port bits": a joystick */
+        return;
+    }
+    if (*p == '#' && sscanf(p + 1, "%d %d %d", &row, &col, &value) == 3) {
+        keyboard_set_keyarr(row, col, value);
+        return;
+    }
     kbdbuf_feed_string(string);
 }
 
