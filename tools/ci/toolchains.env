# The toolchains the builds are checked with, in one place (CI reads this; use the same locally).
# z88dk: the Docker image of the commit the local snap was built from (the snap's channel is nightly: pin it).
Z88DK_IMAGE=z88dk/z88dk:sha-94be67e
# llvm-mos SDK (Atari XL/XE, C64): a GitHub release of llvm-mos/llvm-mos-sdk
LLVM_MOS_VERSION=v23.3.0
# OpenWatcom v2 (the PC): a monthly release of open-watcom/open-watcom-v2, its ow-snapshot.tar.xz
OPENWATCOM_RELEASE=2026-10-01-Build
# Emscripten (the browser)
EMSDK_VERSION=6.0.8
# bebbo's AmigaOS gcc (the Amiga), the image tools/amiga-cc runs
AMIGA_IMAGE=amigadev/crosstools:m68k-amigaos@sha256:983d996c2fd09738a4ea22b97df01e1ad19857fe7027877774090695c2d3951e
# the Atari ST: cross-mint-essential from ppa:vriviere/ppa (its current version)
# amitools (xdftool: the Amiga disk image), from PyPI
AMITOOLS_VERSION=0.8.1
